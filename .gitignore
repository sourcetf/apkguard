# ---- 白名单式忽略：除下列内容外，根目录一律不入库 ----
#
# 本目录是一个 7 GB 的研发工作区（含 Android SDK / NDK / Go 工具链、
# 61 个 APK、大量逆向分析产物），因此采用「先全部忽略、再逐个放行」的写法，
# 避免误提交体积巨大的二进制文件。

/*

# CI 工作流必须入库（根规则 /* 会把它挡住）
!/.github/

# 说明文档与设计文档
#
# .gitattributes 必须入库：它强制 eol=lf，是 CI 的 shell 脚本与 gofmt 的前提。
# 只放行 .gitignore 而漏掉它会让它永远进不了仓库（根规则 /* 会挡住）。
!/.gitattributes
!/.gitignore
!/README.md
!/*.md

# 项目源码
!/apkguard/
!/testapp/
!/scripts/

# 交付说明与实测记录
!/deliver/
!/realworld/

# ---- apkguard：只保留源码 ----
/apkguard/*.exe
/apkguard/apkguard
/apkguard/dist/
/apkguard/*.txt
/apkguard/*.err
/apkguard/*.log
/apkguard/e2e.bat
/apkguard/t/

# ---- testapp：只保留源码（APK 与密钥库不入库）----
/testapp/build/
/testapp/*.apk
/testapp/*.idsig
/testapp/*.dex
/testapp/classes/
/testapp/keystore/
/testapp/aligned.apk

# ---- deliver：只保留说明 ----
/deliver/*.apk
/deliver/*.idsig
/deliver/*.txt

# ---- realworld：只保留实测记录与复现脚本 ----
# 大体积素材（apps/ 下的原始与加固 APK、交叉编译的 apkguard-linux、JDK/Go 工具链）
# 一律不入库：它们都可复现（下载 + 重新加固），入库会让仓库膨胀数百 MB。
/realworld/*
!/realworld/*.md
!/realworld/*.sh
/realworld/apps/
/realworld/apkguard-linux
/realworld/*.tar.gz

# ---- 通用：二进制与构建产物 ----
*.exe
*.dll
*.so
*.apk
*.idsig
*.dex
*.jar
*.zip
*.jks
*.pfx
*.p12
*.keystore
*.img
*.qcow2
*.vmdk

# 测试/调试临时目录
tmpwork/
tmp/
*.log

# ---- 例外：native 库的预编译产物必须入库 ----
#
# embed.go 用 go:embed prebuilt/*/libapkguard.so 把它打进二进制，
# 因此干净检出必须先有这些文件，否则 `go build` 直接失败：
#   pattern prebuilt/*/libapkguard.so: no matching files found
# 它们是我们自己的构建产物（3 个 ABI 合计 48 KB），属于构建输入，
# 与「不提交二进制产物」的一般原则不冲突。
!/apkguard/internal/native/prebuilt/*/libapkguard.so

# ---- 例外：测试固件必须入库 ----
#
# testdata/ 里是 testapp 构建产物（APK 12 KB、DEX 6 KB、二进制 Manifest 2 KB），
# 供 dex/axml/passes/pipeline/cmd 等包的测试当样本用。
#
# 为什么必须入库：这几个包的样本加载器此前只认工作区里的临时路径
# （iterator.apk.apk / dex_tmp/classes2.dex 等，都不在仓库里），
# 于是干净检出（含 CI）下 94 条测试被静默跳过——go test 依然显示 ok，
# 安全网等于不存在。固件入库后这些测试才真正运行。
# 重新生成方式见 testdata/README.md。
!/testdata/
!/testdata/*.apk
!/testdata/*.dex
!/testdata/*.xml
!/testdata/*.md
